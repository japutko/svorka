{
  "name": "svorka",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "db:migrate:local": "wrangler d1 migrations apply svorka-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply svorka-db --remote",
    "deploy": "npm run db:migrate:remote && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@mantine/core": "^8.0.0",
    "@mantine/dates": "^8.3.18",
    "@mantine/hooks": "^8.0.0",
    "@mantine/notifications": "^8.3.18",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-query": "^5.106.0",
    "dayjs": "^1.11.23",
    "hono": "^4.7.0",
    "jose": "^6.2.15",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wrangler": "^4.14.0"
  }
}
